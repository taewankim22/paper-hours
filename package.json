{
  "name": "paper-hours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "serve out --listen tcp://127.0.0.1:5173",
    "preview": "npm run start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "overrides": {
    "serve": { "compression": "1.8.2" }
  },
  "dependencies": {
    "next": "16.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "three": "0.186.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "5.0.11",
    "lucide-react": "^0.577.0",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@types/node": "^24.0.0",
    "serve": "^14.2.5",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
